---
import Base from '../layouts/Base.astro';
import CabezaPagina from '../components/CabezaPagina.astro';
import { pendientes } from '../data/pendientes';

const etiquetas = { pendiente: 'Falta', 'en-revision': 'Lo estamos viendo', aprobado: 'Listo' } as const;
const tipos = { texto: 'Texto', foto: 'Foto', dato: 'Dato', documento: 'Documento', contacto: 'Contacto', funcion: 'Algo nuevo' } as const;
const cuenta = (e: string) => pendientes.filter((p) => p.estado === e).length;
---
<Base titulo="Revisión" descripcion="Lo que todavía falta en la página.">
  <CabezaPagina
    lineas={['Registro de', 'revisión']}
    entrada="Aquí está todo lo que todavía es de ejemplo o que nos falta. Ustedes nos dicen y lo vamos cambiando."
    color="c-tinta"
    nota="las notas amarillas salen de aquí"
  />

  <section class="capitulo capitulo--auto c-papel registro" aria-labelledby="registro-titulo">
    <div class="contenedor">
      <h2 id="registro-titulo" class="titulo-xl">¿Cómo vamos?</h2>
      <div class="resumen" data-revelar>
        <div class="c-coral"><span>{cuenta('pendiente')}</span>faltan</div>
        <div class="c-lima"><span>{cuenta('en-revision')}</span>lo estamos viendo</div>
        <div class="c-teal"><span>{cuenta('aprobado')}</span>listos</div>
      </div>

      <div class="como">
        <h3 class="titulo-l">¿Cómo nos mandan los cambios?</h3>
        <ol>
          <li>Recorran la página con las notas amarillas prendidas (el botón de abajo a la izquierda).</li>
          <li>Mándennos lo que va, diciendo el código de la nota. Por ejemplo: «<strong>PH-04</strong>: la sesión es el 12 de marzo en Tuluá».</li>
          <li>Si quieren cambiar algo que no tiene nota, dígannos en qué página está y qué frase es.</li>
          <li>Cuando algo queda listo, su nota desaparece.</li>
        </ol>
      </div>

      <div class="tabla-envoltura">
        <table class="tabla-registro">
          <caption class="sr-only">Pendientes del sitio</caption>
          <thead><tr><th scope="col">Código</th><th scope="col">Qué falta</th><th scope="col">Qué es</th><th scope="col">Dónde</th><th scope="col">Cómo va</th></tr></thead>
          <tbody>
            {pendientes.map((p) => (
              <tr id={p.id}>
                <th scope="row">{p.id}</th>
                <td><strong>{p.titulo}</strong><br />{p.falta}</td>
                <td>{tipos[p.tipo]}</td>
                <td><a href={p.pagina}>{p.pagina}</a></td>
                <td><span class:list={['estado', `estado--${p.estado}`]}>{etiquetas[p.estado]}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .resumen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 32px 0 56px; }
  .resumen > div { padding: 24px; border-radius: var(--radio); background: var(--fondo); color: var(--texto); font-weight: 700; font-size: 1.1rem; }
  .resumen span { display: block; font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 800; letter-spacing: -0.06em; line-height: 0.9; }
  .como { padding: 28px; border-radius: var(--radio); background: var(--nota); margin-bottom: 40px; max-width: 760px; }
  .como ol { margin: 12px 0 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 6px; }
  .tabla-envoltura { overflow-x: auto; border-radius: var(--radio); background: var(--papel-2); }
  .tabla-registro { width: 100%; min-width: 760px; border-collapse: collapse; }
  .tabla-registro th, .tabla-registro td { text-align: left; vertical-align: top; padding: 16px 18px; }
  .tabla-registro thead th { background: var(--tinta); color: var(--papel); }
  .tabla-registro tbody tr:nth-child(even) { background: #ebe6db; }
  .tabla-registro tbody tr:target { background: var(--nota); animation: marca 1.2s var(--ease-salida); }
  @keyframes marca { from { transform: scale(1.01); } }
  .tabla-registro tbody th { font-weight: 800; white-space: nowrap; }
  .estado { display: inline-block; padding: 4px 12px; border-radius: 999px; font-weight: 700; font-size: 0.9rem; white-space: nowrap; }
  .estado--pendiente { background: var(--coral); }
  .estado--en-revision { background: var(--lima); }
  .estado--aprobado { background: var(--teal); color: var(--papel); }
  @media (max-width: 700px) { .resumen { grid-template-columns: 1fr; } }
</style>
