---
import { agenda } from '../data/agenda';
import Pendiente from './Pendiente.astro';
import Titular from './Titular.astro';
import Flecha from './Flecha.astro';
interface Props { conBoton?: boolean }
const { conBoton = true } = Astro.props;
const colores: Record<string, string> = { Sesión: 'var(--indigo)', Comisión: 'var(--coral)', Encuentro: 'var(--teal)', Taller: 'var(--lima)' };
---
<section class="capitulo capitulo--auto c-papel agenda" aria-labelledby="agenda-titulo">
  <div class="contenedor">
    <div class="agenda__cabeza">
      <Titular lineas={['Lo que', 'se viene']} id="agenda-titulo" class="titulo-xl agenda__titulo" />
      <Pendiente id="PH-04" />
      {conBoton && <a class="boton" href="/agenda">Toda la agenda <Flecha /></a>}
    </div>

    <div class="agenda__cuerpo" data-pestanas>
      <div class="agenda__dias" role="tablist" aria-label="Fechas">
        {agenda.map((d, i) => (
          <button role="tab" id={`tab-${d.id}`} aria-controls={`panel-${d.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="agenda__fecha">{d.fecha}</span>
            <span class="chico">{d.dia}</span>
          </button>
        ))}
      </div>
      <div class="agenda__paneles">
        {agenda.map((d, i) => (
          <div role="tabpanel" id={`panel-${d.id}`} aria-labelledby={`tab-${d.id}`} hidden={i !== 0} class="agenda__panel">
            {d.eventos.map((e) => (
              <article class="agenda__banda">
                <time class="agenda__hora">{e.hora}</time>
                <div>
                  <h3>{e.titulo}</h3>
                  <p class="chico">{e.nota}</p>
                </div>
                <p class="agenda__lugar"><span class="agenda__tipo" style={`--c:${colores[e.tipo]}`}>{e.tipo}</span> {e.lugar}</p>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pestanas]').forEach((grupo) => {
    const tabs = Array.from(grupo.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activar = (t: HTMLButtonElement, foco = false) => {
      tabs.forEach((x) => {
        const sel = x === t;
        x.setAttribute('aria-selected', String(sel));
        x.tabIndex = sel ? 0 : -1;
        const panel = document.getElementById(x.getAttribute('aria-controls')!);
        if (panel) {
          panel.hidden = !sel;
          if (sel) { panel.classList.remove('entra'); void panel.offsetWidth; panel.classList.add('entra'); }
        }
      });
      if (foco) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => activar(t));
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'ArrowDown' || k === 'ArrowRight') { e.preventDefault(); activar(tabs[(i + 1) % tabs.length], true); }
        if (k === 'ArrowUp' || k === 'ArrowLeft') { e.preventDefault(); activar(tabs[(i - 1 + tabs.length) % tabs.length], true); }
      });
    });
  });
</script>

<style>
  .agenda__cabeza { display: flex; align-items: flex-end; gap: 28px; flex-wrap: wrap; margin-bottom: 56px; }
  .agenda__cabeza :global(.agenda__titulo) { margin-right: auto; }
  .agenda__cabeza :global(.agenda__titulo .linea-mascara:first-child) { color: var(--tinta-suave); }
  .agenda__cuerpo { display: grid; grid-template-columns: 170px 1fr; gap: 24px; }
  .agenda__dias { display: flex; flex-direction: column; gap: 8px; }
  .agenda__dias button {
    display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
    min-height: 72px; padding: 10px 18px; border: 0; border-radius: 18px;
    background: var(--papel-2); color: var(--tinta); font-family: var(--f-texto); text-align: left; cursor: pointer;
    transition: transform 0.3s var(--ease-rebote), background-color 0.2s, color 0.2s;
  }
  .agenda__dias button:hover { transform: translateX(6px); }
  .agenda__dias button[aria-selected='true'] { background: var(--tinta); color: var(--papel); transform: translateX(10px); }
  .agenda__fecha { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.03em; }
  .agenda__panel { display: flex; flex-direction: column; gap: 6px; }
  .agenda__panel.entra .agenda__banda { animation: banda 0.6s var(--ease-salida) both; }
  .agenda__panel.entra .agenda__banda:nth-child(2) { animation-delay: 0.08s; }
  .agenda__panel.entra .agenda__banda:nth-child(3) { animation-delay: 0.16s; }
  @keyframes banda { from { opacity: 0; transform: translateX(24px); } }
  .agenda__banda {
    display: grid; grid-template-columns: 100px 1fr auto; gap: 20px; align-items: center;
    min-height: 92px; padding: 16px 24px; border-radius: 18px; background: var(--papel-2);
  }
  .agenda__banda:nth-child(even) { background: #e9e3d6; }
  .agenda__hora { font-size: 1.4rem; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .agenda__banda h3 { font-size: 1.2rem; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 4px; }
  .agenda__banda .chico { color: var(--tinta-suave); }
  .agenda__lugar { font-weight: 600; display: flex; align-items: center; gap: 10px; text-align: right; }
  .agenda__tipo { background: var(--c); color: var(--papel); padding: 4px 10px; border-radius: 999px; font-size: 0.85rem; font-weight: 700; }
  .agenda__tipo[style*='lima'] { color: var(--tinta); }
  @media (max-width: 760px) {
    .agenda__cuerpo { grid-template-columns: 1fr; }
    .agenda__dias { flex-direction: row; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
    .agenda__dias button { flex: 0 0 auto; min-width: 104px; }
    .agenda__dias button[aria-selected='true'], .agenda__dias button:hover { transform: translateY(-3px); }
    .agenda__banda { grid-template-columns: 1fr; gap: 6px; }
    .agenda__lugar { text-align: left; }
  }
</style>
