---
import { pendiente, frase } from '../data/pendientes';

interface Props {
  id: string;
  lado?: 'izquierda' | 'derecha';
  class?: string;
}
const { id, lado = 'izquierda', class: clase = '' } = Astro.props;
const p = pendiente(id);
if (!p) throw new Error(`Pendiente desconocido: ${id}`);
---
<aside class:list={['pendiente', lado === 'derecha' && 'pendiente--derecha', clase]} aria-label={`${p.id}: ${frase(p)}`}>
  <span class="pendiente__cabeza"><span class="pendiente__id">{p.id}</span> {frase(p)}</span>
  <a href={`/revision#${p.id}`}>¿Qué falta?</a>
</aside>
