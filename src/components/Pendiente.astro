---
// Nota de revisión: marca un contenido de ejemplo que la Plataforma debe
// avalar o entregar. Lee el texto del registro (src/data/pendientes.ts).
import { pendiente } from '../data/pendientes';

interface Props {
  id: string;
  lado?: 'izquierda' | 'derecha';
  class?: string;
}
const { id, lado = 'izquierda', class: clase = '' } = Astro.props;
const p = pendiente(id);
if (!p) throw new Error(`Pendiente desconocido: ${id}`);
---
<aside class:list={['pendiente', lado === 'derecha' && 'pendiente--derecha', clase]} aria-label={`Nota de revisión ${p.id}: ${p.titulo}`}>
  <span class="pendiente__cabeza"><span class="pendiente__id">{p.id}</span> {p.titulo}</span>
  <span>{p.falta}</span>
  <a href={`/revision#${p.id}`}>Ver en el registro</a>
</aside>
