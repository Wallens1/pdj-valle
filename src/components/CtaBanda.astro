---
interface Props { palabra: string; frase: string; href: string; color?: string }
const { palabra, frase, href, color = 'c-coral' } = Astro.props;
---
<a class:list={['cta', color]} href={href}>
  <span class="cta__frase">{frase}</span>
  <svg class="cta__flecha" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 36 36 12M16 12h20v20" /></svg>
  <span class="cta__palabra" aria-hidden="true">{palabra.split('').map((l, i) => <span style={`--i:${i}`}>{l}</span>)}</span>
  <span class="sr-only">{palabra}</span>
</a>

<style>
  .cta {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 62svh;
    padding: 28px var(--margen) 18px;
    background: var(--fondo);
    color: var(--texto);
    text-decoration: none;
    overflow: hidden;
    transition: background-color 0.25s, color 0.25s;
  }
  .cta:hover, .cta:focus-visible { background: var(--tinta); color: var(--lima); }
  .cta:focus-visible { outline-offset: -8px; }
  .cta__frase { position: absolute; top: 28px; left: var(--margen); max-width: 32ch; font-size: var(--t-l); font-weight: 600; line-height: 1.2; }
  .cta__flecha { position: absolute; top: 24px; right: var(--margen); width: clamp(36px, 4vw, 56px); transition: transform 0.5s var(--ease-rebote); }
  .cta:hover .cta__flecha { transform: translate(6px, -6px) rotate(8deg); }
  .cta__palabra {
    display: flex;
    font-size: clamp(5.5rem, 25vw, 26rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.78;
    white-space: nowrap;
  }
  .cta__palabra span { display: inline-block; transition: transform 0.5s var(--ease-rebote); transition-delay: calc(var(--i) * 30ms); }
  .cta:hover .cta__palabra span { transform: translateY(-0.08em) rotate(calc((var(--i) - 3) * 2deg)); }
  @media (max-width: 700px) { .cta { min-height: 46svh; } }
</style>
