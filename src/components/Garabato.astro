---
interface Props {
  forma: 'espiral' | 'flecha' | 'estrella' | 'circulo' | 'rayos' | 'onda' | 'flecha-curva';
  class?: string;
  style?: string;
}
const { forma, class: clase = '', style } = Astro.props;

const formas: Record<string, { vb: string; d: string[] }> = {
  espiral: { vb: '0 0 120 120', d: ['M60 62 L60 52 L70 52 L70 72 L48 72 L48 40 L82 40 L82 84 L36 84 L36 28 L94 28 L94 96 L24 96 L24 16 L104 16'] },
  flecha: { vb: '0 0 160 60', d: ['M6 34 C 40 18, 90 50, 140 26', 'M118 12 L142 26 L122 44'] },
  'flecha-curva': { vb: '0 0 120 140', d: ['M20 10 C 100 10, 110 80, 50 120', 'M44 96 L48 124 L76 116'] },
  estrella: { vb: '0 0 100 100', d: ['M50 8 L58 40 L92 42 L64 60 L76 92 L50 72 L24 92 L36 60 L8 42 L42 40 Z'] },
  circulo: { vb: '0 0 220 110', d: ['M150 14 C 70 0, 8 30, 14 62 C 20 98, 140 104, 196 72 C 230 50, 200 14, 120 12'] },
  rayos: { vb: '0 0 100 100', d: ['M50 6 L50 30', 'M84 18 L68 36', 'M96 54 L72 54', 'M16 18 L32 36', 'M4 54 L28 54'] },
  onda: { vb: '0 0 300 40', d: ['M4 22 C 30 2, 50 2, 76 22 S 122 42, 148 22 S 196 2, 222 22 S 270 42, 296 22'] },
};
const f = formas[forma];
---
<svg class:list={['garabato', clase]} style={style} viewBox={f.vb} aria-hidden="true" focusable="false">
  {f.d.map((d) => <path d={d} />)}
</svg>
